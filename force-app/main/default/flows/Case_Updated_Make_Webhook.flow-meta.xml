<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <description>When a Case is updated, sends the Case Id and Case Number to a Make (Integromat) webhook.</description>
    <interviewLabel>Case Updated - Make Webhook {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case Updated - Make Webhook</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <connector>
            <targetReference>Send_To_Make_Webhook</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <actionCalls>
        <name>Send_To_Make_Webhook</name>
        <label>Send to Make Webhook</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <actionName>CaseWebhookCallout</actionName>
        <actionType>apex</actionType>
        <inputParameters>
            <name>caseId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>caseNumber</name>
            <value>
                <elementReference>$Record.CaseNumber</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
</Flow>
